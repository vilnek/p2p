<?xml version="1.0" encoding="utf-8"?>
<!-- P2P Talk sends photos and videos as the original bytes: Android must never convert them for
     this app (compatible media transcoding). Referenced from AndroidManifest.xml. -->
<media-capabilities xmlns:android="http://schemas.android.com/apk/res/android">
    <format android:name="HEVC" supported="true" />
    <format android:name="HDR10" supported="true" />
    <format android:name="HDR10Plus" supported="true" />
    <format android:name="HLG" supported="true" />
</media-capabilities>
